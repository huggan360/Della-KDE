frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#242b33
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.left=4
text.margin.right=4
text.margin.top=2
text.margin.bottom=2

